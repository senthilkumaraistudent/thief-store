# Copy this file to `.env` and fill in real values. Never commit the real .env file.

DJANGO_SECRET_KEY=change-this-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=alpha_z_db
DB_USER=alpha_z_user
DB_PASSWORD=change-this-password
DB_HOST=localhost
DB_PORT=3306

# The URL(s) your React frontend runs on, comma-separated
CORS_ALLOWED_ORIGINS=http://localhost:5173
